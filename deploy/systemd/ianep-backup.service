[Unit]
Description=Create and verify IANep production backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ianep
Group=ianep
WorkingDirectory=/opt/ianep/app
Environment=NODE_ENV=production
Environment=IANEP_BACKUP_ROLE=scheduled
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env node --env-file=.env.local --import tsx scripts/backup.ts scheduled
UMask=0077
TimeoutStartSec=50m
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/ianep
ReadOnlyPaths=/var/lib/ianep/storage
PrivateTmp=true
