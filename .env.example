POSTGRES_USER=ianep
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ianep
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ianep:replace-with-a-local-password@localhost:5432/ianep?schema=public

# Admin MVP. Учётные записи хранятся в PostgreSQL.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
CLIENT_IP_HEADER=x-real-ip
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=IANep
SMTP_REPLY_TO=
NOTIFICATION_DISPATCH_LIMIT=50
IANEP_STORAGE_DIR=.ianep-storage
